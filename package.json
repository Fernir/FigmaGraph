{
  "name": "figmagraph",
  "version": "0.1.4",
  "description": "Local Figma knowledge graph MCP for Cursor, Claude, Codex, and more — Rust core, Layout IR",
  "type": "module",
  "bin": {
    "figmagraph": "./dist/cli.js"
  },
  "files": [
    "dist",
    "native",
    "plugin",
    "README.md",
    "PUBLISH.md",
    "AGENT_RULE.md",
    "AGENT_RULE_IMPLEMENT.md",
    "LICENSE",
    "scripts/postinstall-native.js",
    "scripts/build-native.js",
    "crates/figmagraph-core"
  ],
  "scripts": {
    "build": "tsc && node scripts/chmod-cli.js && node scripts/build-native.js",
    "build:js": "tsc && node scripts/chmod-cli.js",
    "build:native": "node scripts/build-native.js",
    "postinstall": "node scripts/postinstall-native.js",
    "prepublishOnly": "npm run build && npm test",
    "postpublish": "node scripts/bump-after-publish.js",
    "version:sync": "node scripts/bump-after-publish.js",
    "dev": "tsx src/cli.ts",
    "mcp": "tsx src/mcp/server.ts",
    "test": "FIGMAGRAPH_ALLOW_JS_FALLBACK=1 tsx --test src/layout-ir.test.ts src/golden-ir.test.ts src/ingest-mcp.test.ts src/url-strip.test.ts",
    "doctor": "tsx src/cli.ts doctor"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "figma",
    "mcp",
    "cursor",
    "claude",
    "codex",
    "layout",
    "rust"
  ],
  "license": "MIT",
  "figmagraph": {
    "nativeReleaseBase": "https://github.com/Fernir/figmagraph/releases/download"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^11.9.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
